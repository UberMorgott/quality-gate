#!/bin/sh
# Quality gate, pre-push (quality-gate#180). Installed by quality-gate -- do not edit here.
#
# Same platform switch as templates/pre-commit, for the same measured reason. git's
# `<local ref> <local sha> <remote ref> <remote sha>` lines arrive on stdin and are
# inherited by exec; `qgate pre-push` refuses anything but the clean checked-out HEAD
# and then gates it with -All -Full.
if uname -o 2>/dev/null | grep -q Msys; then
  exec qgate.cmd pre-push
else
  exec qgate pre-push
fi
